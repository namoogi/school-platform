{
  "name": "school-platform",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/predeploy.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/migrate.mjs --reset && node scripts/seed.mjs",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/flow.mjs",
    "test:unit": "vitest run tests/csv.test.ts tests/readers.test.ts tests/table-sort.test.ts tests/site-import.test.ts tests/pdf-check.test.ts tests/site-edit.test.ts",
    "check:repo": "node scripts/check-repo.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@fontsource/noto-serif-kr": "^5.3.1",
    "@fontsource/noto-serif-thai": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sun-typeface/suit": "^2.0.5",
    "exceljs": "^4.4.0",
    "fflate": "^0.7.5",
    "lucide-react": "^1.70.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.6",
    "node-html-parser": "^9.0.7",
    "pg": "^8.23.1",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4.14.0",
    "docx": "^9.15.3",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
