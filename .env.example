# 이 프로젝트 전용 Supabase(또는 로컬 Postgres) 연결. 드리미포털의 값을 쓰지 않는다.
# Supabase: Project Settings → Database → Connection string (Transaction pooler, 6543 포트) 권장
DATABASE_URL=postgres://postgres@127.0.0.1:54322/school_platform
# 세션 쿠키 서명 키. 32자 이상 임의 문자열 (openssl rand -base64 48)
SESSION_SECRET=local-dev-only-session-secret-change-me-0123456789
# 선택: 예시 관리자 비밀번호 (지정하지 않으면 demo-pass-a / demo-pass-b)
# SEED_PASSWORD_A=
# SEED_PASSWORD_B=
